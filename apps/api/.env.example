# Ambiente: development | production
CADENCIA_ENVIRONMENT=development

# Banco: SQLite local por padrao; Neon em producao (use o endpoint -pooler)
CADENCIA_DATABASE_URL=sqlite+aiosqlite:///./cadencia.db
# CADENCIA_DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/cadencia?sslmode=require

# Segredos (gere valores fortes em producao)
CADENCIA_JWT_SECRET=cadencia-dev-secret-change-me
CADENCIA_INTEGRATION_SECRET_KEY=

# URLs
CADENCIA_WEB_BASE_URL=http://localhost:5173
CADENCIA_API_BASE_URL=http://localhost:8000
CADENCIA_CORS_ORIGINS=http://localhost:5173

# Cookies (true em producao/HTTPS)
CADENCIA_COOKIE_SECURE=false

# Jira Cloud OAuth 2.0 (3LO) — https://developer.atlassian.com/console/myapps/
CADENCIA_JIRA_CLIENT_ID=
CADENCIA_JIRA_CLIENT_SECRET=

# Trello — API key do app em https://trello.com/power-ups/admin (o usuario autoriza via /1/authorize)
CADENCIA_TRELLO_API_KEY=
